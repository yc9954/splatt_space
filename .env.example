# Copy this file to .env and fill in the values you have.
# All variables are optional: with none of them set the app runs in demo
# mode against bundled sample scenes (no backend needed).
# Restart the dev server after changing anything here (expo start --clear).

# --- Supabase (auth, database, realtime) ------------------------------------
# Dashboard > Settings > API. Leave both blank to stay in demo mode.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- KIRI Engine (video -> 3D Gaussian splat capture) ------------------------
# https://www.kiriengine.app  Dashboard > API Keys
EXPO_PUBLIC_KIRI_API_KEY=

# --- OpenAI (Travel AI chat) -------------------------------------------------
# Without a key the chat answers with canned demo replies.
EXPO_PUBLIC_OPENAI_API_KEY=

# --- Luma AI (optional image-to-3D API) ---------------------------------------
EXPO_PUBLIC_LUMA_API_KEY=

# --- Demo mode ----------------------------------------------------------------
# Set to true to force the in-memory backend even when Supabase is configured.
EXPO_PUBLIC_DEMO_MODE=false
